# --- add these to the Laravel .env ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://payments.amowogbaje.com

# No queue worker: everything runs inline / after the response / from cron.
QUEUE_CONNECTION=sync

PAYMENT_DEFAULT_GATEWAY=paystack
PAYMENT_EXPIRE_HOURS=24

FLW_SECRET_KEY=
FLW_SECRET_HASH=                 # same value you set as "Secret hash" in the Flutterwave dashboard

PAYSTACK_SECRET_KEY=
